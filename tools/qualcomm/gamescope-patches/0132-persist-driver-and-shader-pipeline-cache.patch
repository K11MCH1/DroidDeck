+static uint64_t cache_hash(const std::vector<char>& data)
+{
+	uint64_t hash = 14695981039346656037ull;
+	for (unsigned char byte : data)
+		hash = (hash ^ byte) * 1099511628211ull;
+	return hash;
+}
+
+void CVulkanDevice::createPipelineCache()
+{
+	VkPhysicalDeviceProperties properties{};
+	vk.GetPhysicalDeviceProperties(physDev(), &properties);
+	char identity[160];
+	int used = snprintf(identity, sizeof(identity), "v1-%x-%x-%x-%016llx-", properties.vendorID,
+	                    properties.deviceID, properties.driverVersion, (unsigned long long)m_pipelineShaderHash);
+	for (unsigned char byte : properties.pipelineCacheUUID)
+		used += snprintf(identity + used, sizeof(identity) - used, "%02x", byte);
+	const char *cacheHome = getenv("XDG_CACHE_HOME");
+	const char *home = getenv("HOME");
+	std::filesystem::path directory;
+	if (cacheHome && *cacheHome)
+		directory = std::filesystem::path(cacheHome) / "gamescope/pipelines";
+	else if (home && *home)
+		directory = std::filesystem::path(home) / ".cache/gamescope/pipelines";
+	std::vector<char> data;
+	if (!directory.empty()) {
+		std::error_code error;
+		std::filesystem::create_directories(directory, error);
+		if (!error) {
+			m_pipelineCachePath = (directory / (std::string(identity) + ".bin")).string();
+			std::ifstream file(m_pipelineCachePath, std::ios::binary);
+			uint64_t header[3]{};
+			if (file.read(reinterpret_cast<char *>(header), sizeof(header)) &&
+			    header[0] == 0x3148434143504444ull && header[1] >= sizeof(VkPipelineCacheHeaderVersionOne) &&
+			    header[1] <= 64 * 1024 * 1024) {
+				data.resize(header[1]);
+				if (!file.read(data.data(), data.size()) || file.peek() != EOF || cache_hash(data) != header[2])
+					data.clear();
+				if (!data.empty()) {
+					VkPipelineCacheHeaderVersionOne vkHeader;
+					memcpy(&vkHeader, data.data(), sizeof(vkHeader));
+					if (vkHeader.headerSize < sizeof(vkHeader) || vkHeader.headerSize > data.size() ||
+					    vkHeader.headerVersion != VK_PIPELINE_CACHE_HEADER_VERSION_ONE ||
+					    vkHeader.vendorID != properties.vendorID || vkHeader.deviceID != properties.deviceID ||
+					    memcmp(vkHeader.pipelineCacheUUID, properties.pipelineCacheUUID, VK_UUID_SIZE))
+						data.clear();
+				}
+			}
+		}
+	}
+	VkPipelineCacheCreateInfo info{ .sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO,
+	                               .initialDataSize = data.size(), .pInitialData = data.data() };
+	VkResult result = vk.CreatePipelineCache(device(), &info, nullptr, &m_pipelineCache);
+	if (result != VK_SUCCESS && !data.empty()) {
+		info.initialDataSize = 0;
+		info.pInitialData = nullptr;
+		result = vk.CreatePipelineCache(device(), &info, nullptr, &m_pipelineCache);
+		data.clear();
+	}
+	if (result != VK_SUCCESS)
+		m_pipelineCache = VK_NULL_HANDLE;
+	vk_log.infof("Pipeline cache: %zu bytes loaded, %s", data.size(), m_pipelineCache ? "enabled" : "unavailable");
+}
+
+void CVulkanDevice::savePipelineCache()
+{
+	std::unique_lock<std::shared_mutex> lock(m_pipelineCacheMutex);
+	if (!m_pipelineCache || m_pipelineCachePath.empty())
+		return;
+	size_t size = 0;
+	if (vk.GetPipelineCacheData(device(), m_pipelineCache, &size, nullptr) != VK_SUCCESS ||
+	    size < sizeof(VkPipelineCacheHeaderVersionOne) || size > 64 * 1024 * 1024)
+		return;
+	std::vector<char> data(size);
+	if (vk.GetPipelineCacheData(device(), m_pipelineCache, &size, data.data()) != VK_SUCCESS)
+		return;
+	data.resize(size);
+	const uint64_t header[] = {0x3148434143504444ull, data.size(), cache_hash(data)};
+	const std::string temporary = m_pipelineCachePath + "." + std::to_string(getpid()) + ".tmp";
+	std::ofstream file(temporary, std::ios::binary | std::ios::trunc);
+	file.write(reinterpret_cast<const char *>(header), sizeof(header));
+	file.write(data.data(), data.size());
+	file.close();
+	if (!file || rename(temporary.c_str(), m_pipelineCachePath.c_str()))
+		unlink(temporary.c_str());
+	else
+		vk_log.infof("Pipeline cache: saved %zu bytes", data.size());
+}
