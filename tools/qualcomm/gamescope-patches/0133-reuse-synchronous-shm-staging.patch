+class CShmUploadBuffer
+{
+public:
+	~CShmUploadBuffer() { reset(); }
+	bool ensure(VkDeviceSize size)
+	{
+		if (size <= capacity)
+			return true;
+		reset();
+		VkBufferCreateInfo info = { .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+		                            .size = size, .usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT };
+		if (g_device.vk.CreateBuffer(g_device.device(), &info, nullptr, &buffer) != VK_SUCCESS) {
+			buffer = VK_NULL_HANDLE;
+			return false;
+		}
+		VkMemoryRequirements requirements;
+		g_device.vk.GetBufferMemoryRequirements(g_device.device(), buffer, &requirements);
+		int32_t type = g_device.findMemoryType(VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT,
+		                                     requirements.memoryTypeBits);
+		if (type < 0) {
+			reset();
+			return false;
+		}
+		VkMemoryAllocateInfo allocate = { .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+		                                 .allocationSize = requirements.size, .memoryTypeIndex = uint32_t(type) };
+		if (g_device.vk.AllocateMemory(g_device.device(), &allocate, nullptr, &memory) != VK_SUCCESS) {
+			memory = VK_NULL_HANDLE;
+			reset();
+			return false;
+		}
+		if (g_device.vk.BindBufferMemory(g_device.device(), buffer, memory, 0) != VK_SUCCESS) {
+			reset();
+			return false;
+		}
+		if (g_device.vk.MapMemory(g_device.device(), memory, 0, VK_WHOLE_SIZE, 0, &mapped) != VK_SUCCESS) {
+			mapped = nullptr;
+			reset();
+			return false;
+		}
+		capacity = size;
+		return true;
+	}
+	VkBuffer buffer = VK_NULL_HANDLE;
+	void *mapped = nullptr;
+	VkDeviceSize capacity = 0;
+private:
+	void reset()
+	{
+		if (mapped)
+			g_device.vk.UnmapMemory(g_device.device(), memory);
+		if (buffer)
+			g_device.vk.DestroyBuffer(g_device.device(), buffer, nullptr);
+		if (memory)
+			g_device.vk.FreeMemory(g_device.device(), memory, nullptr);
+		buffer = VK_NULL_HANDLE;
+		memory = VK_NULL_HANDLE;
+		mapped = nullptr;
+		capacity = 0;
+	}
+	VkDeviceMemory memory = VK_NULL_HANDLE;
+};
