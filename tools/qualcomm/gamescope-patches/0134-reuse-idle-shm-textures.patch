+#pragma once
+
+#include <vector>
+#include "rc.h"
+
+template<typename Texture>
+class CShmTexturePool
+{
+public:
+
+    explicit CShmTexturePool(uint64_t limit = 16 * 1024 * 1024) : m_limit(limit) {}
+
+    gamescope::OwningRc<Texture> acquire(uint32_t width, uint32_t height, uint32_t format)
+    {
+        for (const auto& texture : m_textures) {
+            if (idle(texture) && texture->width() == width && texture->height() == height && texture->drmFormat() == format) {
+                ++m_reuses;
+                return texture;
+            }
+        }
+        return nullptr;
+    }
+
+    void retain(const gamescope::OwningRc<Texture>& texture)
+    {
+        const uint64_t size = texture->totalSize();
+        if (size > m_limit)
+            return;
+        while (m_textures.size() >= 8 || m_bytes > m_limit - size) {
+            auto available = m_textures.end();
+            for (auto entry = m_textures.begin(); entry != m_textures.end(); ++entry)
+                if (idle(*entry)) { available = entry; break; }
+            if (available == m_textures.end())
+                return;
+            m_bytes -= (*available)->totalSize();
+            m_textures.erase(available);
+        }
+        m_textures.push_back(texture);
+        m_bytes += size;
+    }
+
+    uint64_t retainedBytes() const { return m_bytes; }
+    uint64_t reuses() const { return m_reuses; }
+
+private:
+    static bool idle(const gamescope::OwningRc<Texture>& texture)
+    {
+        // Commits and pending GPU commands retain public refs; only the pool may own an idle snapshot.
+        return !texture->IsInUse() && texture->GetRefCountPrivate() == 1;
+    }
+
+    uint64_t m_limit;
+    uint64_t m_bytes = 0;
+    uint64_t m_reuses = 0;
+    std::vector<gamescope::OwningRc<Texture>> m_textures;
+};
